  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProjectRidge.Items.Clue
  focus: {fileID: 0}
  displayName: the map
  title: A TRAIL MAP
  body: 'Pinned under a rock on the bench. A route drawn in red marker from the station
    to the access road, circled twice:

    "RANGER TRUCK - RADIO"


    Under it,
    smaller, shakier: "they only come when the light is on you"'
  objectiveAfter: Reach the truck on the access road.
